# Local databases, exports, and secrets (see CLAUDE.md, Public Repository Rules)
*.db
*.sqlite*
*.tiffin
.env*
/local/
/data/
# Project archives downloaded from TiffinDB (M3, ExportOperations::ARCHIVE_SUFFIX).
# Staging folders live under the data folder (<data>/staging/), covered by /data/.
*.tiffindb.zip
# Installer exposure-probe control files written at runtime (spec 10.4, P75)
/public/probe-*.txt
# Installation-specific settings (M1 spec part 2 section 2.9)
/config/local.php

# Legacy source files used for import discovery must never be committed
*.bentodb
*.bentoTemplate
*.bento

# Dependencies and tooling
# vendor/ is git-ignored during development and shipped only in the release archive.
/vendor/
# The lock file embeds third-party authors' names and email addresses (ADR 0008).
/composer.lock
/composer.phar
.phpunit.cache/
/phpunit.xml
# npm is a download channel for font files only; nothing from it is committed.
/node_modules/
/package.json
/package-lock.json
*.tgz

# Release build output (M7)
/build/
/dist/

# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
